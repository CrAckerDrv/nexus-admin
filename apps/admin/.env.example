# 接口基地址。去掉前缀以走同源 /api（演示模式）
# VITE_API_BASE=https://api.your-domain.com

# 功能开关示例：模块协议中的 enabled 可读取该变量
# VITE_ENABLE_BETA=false

# ---------------------------------------------------------------------------
# AI 运营助手 · 供应商回退链
#
# 规则：只有「服务端环境变量」能放密钥；VITE_* 会被打进浏览器包，绝不可放密钥。
# 复制为 .env.local 后按需取消注释，dev server 会自动加载。
#
# 回退顺序（配了就优先用，失败自动换下一家）：
#   opencode（有 key） → custom（有 AI_API_KEY） → pollinations（免密钥，始终可用）
# ---------------------------------------------------------------------------

# ① OpenCode —— 免费档 / Go 订阅，性价比最高
#    Console 建个人密钥：https://opencode.ai/console → Account → Personal API keys
# OPENCODE_API_KEY=oc_sk_xxxxxxxxxxxxxxxx
# AI_MODEL=deepseek-v4.1-flash-free
# AI_MODEL=glm-5.3-flash-free
# AI_MODEL=kimi-k3

# ② 任意 OpenAI 兼容服务（DeepSeek 官方 / Moonshot / 自建 BFF…）
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_UPSTREAM=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ③ 免密钥通道（Pollinations）—— 不配任何东西就能用，方便评委/客户直接体验
#    额度：每 IP 每 45 秒 1 条；要更快的节奏请配 ① 或 ②
#    （无密钥时网关会自动用它，无需显式开启）

# 强制只用某一家（排查问题时有用）：opencode | custom | pollinations
# AI_PROVIDER=pollinations

# 前端可覆盖网关地址（非密钥，可公开）
# VITE_AI_BASE_URL=/ai-gateway

# ---------------------------------------------------------------------------
# 人机验证 · Cloudflare Turnstile（登录页）
#
# 规则同上：**site key 是公开值**，可以进浏览器包；**secret key 绝不能**。
# secret 只放在你的后端环境变量里（TURNSTILE_SECRET），由后端调 siteverify 判定。
# ---------------------------------------------------------------------------

# site key（公开）。不配时：演示模式自动用 Cloudflare「永远通过」测试 key
# （1x00000000000000000000AA），生产构建用内置正式 key。
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF1Fc2tsbu8bVO-a

# 前端是否拦截「未通过就不提交」。默认开启；联调后端时可临时关掉。
# VITE_TURNSTILE_ENFORCE=false

